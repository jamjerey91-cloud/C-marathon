#include <stdio.h>
int main() {
	
	float length, width, area, perimeter;
	
	printf("Enter length of a rectangle ");
	scanf("%f", &length);
	
	printf("Enter width of a rectangle: ");
	scanf("%f", &width);
	
	area = length * width;
	
	perimeter = (length + width) * 2;
	
	printf("area = %.2f \n", area);
	
	printf("perimeter = %.2f \n", perimeter);
	
	return 0;
	
}