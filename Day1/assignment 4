#include <stdio.h>
int main() {
	
	 int operation;
	double num1, num2, sum;
	
	printf("Enter operation (+, -, *, /): ");
	scanf("%c", &operation);
	
	printf("Enter num1: ");
	scanf("%d", &num1);
	
	printf("Enter num2: ");
	scanf("%d", &num2);

	switch (operation){
	case '+':
	sum = num1 + num2;
	printf("sum = %d + %d is %d", num1, num2, sum);
	break;
	
	case '-':
	sum = num1 - num2;
	printf("sum = %d - %d is %d", num1, num2, sum);
	break;
	
	case '*':
	sum = num1 * num2;
	printf("sum = %d * %d is %d", num1, num2, sum);
	break;
	
	case '/':
	sum = num1 / num2;
	if(num2 != 0) {
			printf("sum = %d / %d is %d", num1, num2, sum);
			} else {
				printf("Error, zero cannot divide any number");
			}
			break;
		default:
			printf("invalid operation");
	}
	return 0;
}