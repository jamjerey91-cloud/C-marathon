#include <stdio.h>
int main() {
	
	int a, b, temp;
	
	printf("Enter values for a: ");
	scanf("%c",&a);
	
	printf("Enter values for b: ");
	scanf("%c",&b);
	
	printf("Before swapping a = %d, b = %d\n", a, b);
	
	// swapping
	a = a + b; // a hold the sum of both
	b = a - b; // b becomes original value of a
	a = a - b; // a becomes original value of b
	
	printf("After swapping a = %d, b = %d\n", a, b);
	
	return 0;
}