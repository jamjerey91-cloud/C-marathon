#include <stdio.h>
int main() {
	
	int a, b, temp;
	
	printf("Enter values for a: ");
	scanf("%c",&a);
	
	printf("Enter values for b: ");
	scanf("%c",&b);
	
	printf("Before swapping a = %d, b = %d\n", a, b);
	// swapping
	temp = a;
	a = b;
	b = temp;
	
	printf("After swapping a = %d, b = %d\n", a, b);
	
	return 0;
}